<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>NwTaggerProbe</AssemblyName>
    <RootNamespace>NwTaggerProbe</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyTitle>AB Tagger Redline Probe</AssemblyTitle>
    <Product>AB Tagger Redline Probe</Product>
    <Company>Abdullah Lotfy</Company>
    <Version>1.0.0</Version>
    <Description>Diagnostic: dumps the Navisworks 2027 redline serialisation format.</Description>
    <DebugType>portable</DebugType>

    <!-- No trailing separator; NwApiPath adds it. -->
    <NavisworksDir>C:\Program Files\Autodesk\Navisworks Manage 2027</NavisworksDir>
    <NwApiPath>$(NavisworksDir)\</NwApiPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NwApiPath)Autodesk.Navisworks.Api.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.ComApi">
      <HintPath>$(NwApiPath)Autodesk.Navisworks.ComApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Interop.ComApi">
      <HintPath>$(NwApiPath)Autodesk.Navisworks.Interop.ComApi.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <!--
    Shared with the tagger. Both files are pure BCL - no Navisworks types - so
    they compile against any release, which is the point: one serialiser, used
    by the probe here and by the 2027 build of the product.
  -->
  <ItemGroup>
    <Compile Include="..\NwTagger\Core\MarkupModel.cs">
      <Link>Shared\MarkupModel.cs</Link>
    </Compile>
    <Compile Include="..\NwTagger\Core\RedlineJson.cs">
      <Link>Shared\RedlineJson.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>

</Project>
