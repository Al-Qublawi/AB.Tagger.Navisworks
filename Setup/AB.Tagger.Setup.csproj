<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AB.Tagger.Setup.exe - the AB Adv Tools installer engine (shared\ABAdvTools) plus this
    add-in's definition in TaggerSetup.cs. Build it with build-installer.ps1, which fills
    payload\ with one zip per Navisworks release first.

    net48 on purpose: .NET Framework 4.8 is on every machine that can run Navisworks, so the
    installer needs no runtime of its own.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>AB.Tagger.Setup</AssemblyName>
    <RootNamespace>NwTaggerSetup</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <ApplicationIcon>setup.ico</ApplicationIcon>

    <!-- Version comes from the add-in project: build-installer.ps1 passes -p:Version. -->
    <AssemblyTitle>AB Tagger Setup</AssemblyTitle>
    <Product>AB Tagger</Product>
    <Company>Abdullah Lotfy</Company>
    <Authors>Abdullah Lotfy</Authors>
    <Copyright>Copyright (c) 2026 Abdullah Lotfy. All rights reserved.</Copyright>
    <Description>Installs AB Tagger for Autodesk Navisworks.</Description>

    <ABAdvToolsProductLogo>..\NwTagger\Images\logo.png</ABAdvToolsProductLogo>
  </PropertyGroup>

  <Import Project="..\shared\ABAdvTools\build\ABAdvTools.Setup.targets" />

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
